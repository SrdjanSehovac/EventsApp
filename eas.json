{
  "cli": {
    "version": ">= 16.0.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "ios": {
        "simulator": false
      }
    },
    "development-simulator": {
      "developmentClient": true,
      "distribution": "internal",
      "ios": {
        "simulator": true
      }
    },
    "preview": {
      "distribution": "internal",
      "channel": "preview",
      "env": {
        "EXPO_PUBLIC_API_URL": "https://51-161-102-13.sslip.io"
      }
    },
    "production": {
      "channel": "production",
      "autoIncrement": true,
      "ios": {
        "resourceClass": "default"
      },
      "env": {
        "EXPO_PUBLIC_API_URL": "https://51-161-102-13.sslip.io"
      }
    }
  },
  "submit": {
    "production": {
      "ios": {
        "ascAppId": "6822104316",
        "appleTeamId": "7RM28DFSH3"
      }
    }
  }
}
